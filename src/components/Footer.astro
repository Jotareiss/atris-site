---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">

    <!-- Marca -->
    <div class="footer__brand">
      <a href="/" aria-label="Átris — página inicial">
        <img src="/logo-negativa.svg" alt="Átris" height="28" class="footer__logo" />
      </a>
      <p class="footer__tagline"><em>Átris Psiquiatria</em></p>
    </div>

    <!-- Endereço + telemedicina -->
    <div class="footer__contact">
      <address class="footer__address">
        <a href="https://www.google.com/maps/search/?api=1&amp;query=Cavalheiro%20Torquato%20Rizzi%2C%201805%2C%20sala%2024%2C%20Jardim%20S%C3%A3o%20Luiz%2C%20Ribeir%C3%A3o%20Preto%2C%20SP%2C%2014021-676" target="_blank" rel="noopener noreferrer" class="footer__map-link">
          Cavalheiro Torquato Rizzi, 1805, sala 24 — Jardim São Luiz
          Ribeirão Preto, SP — CEP 14021-676
        </a>
      </address>
      <p class="footer__telemedicine">
        Telemedicina para todo o Brasil · CFM nº 2.314/2022
      </p>
    </div>

  </div>

  <!-- Rodapé inferior -->
  <div class="footer__bottom">
    <p class="footer__copy">
      &copy; {year} Átris Psiquiatria. Todos os direitos reservados.
      <a href="/privacidade" class="footer__privacy">Privacidade e dados</a>
    </p>
    <p class="footer__disclaimer">
      As informações deste site têm caráter educativo e não substituem avaliação médica.
    </p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: rgba(246, 239, 227, 0.85);
    padding-top: 40px;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-6) 28px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  /* Marca */
  .footer__logo {
    display: block;
    margin-bottom: 14px;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-style: italic;
    line-height: 1.5;
    color: rgba(246, 239, 227, 0.6);
    margin: 0;
  }

  /* Endereço */
  .footer__contact {
    text-align: right;
  }

  .footer__address {
    font-size: var(--text-sm);
    font-style: normal;
    line-height: 1.6;
    margin: 0 0 6px;
  }

  .footer__map-link {
    color: rgba(246, 239, 227, 0.72);
    text-decoration: none;
    border-bottom: 1px solid rgba(246, 239, 227, 0.2);
    transition: color var(--transition), border-color var(--transition);
  }

  .footer__map-link:hover {
    color: rgba(246, 239, 227, 0.95);
    border-color: rgba(246, 239, 227, 0.6);
  }

  .footer__telemedicine {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: rgba(246, 239, 227, 0.4);
    margin: 0;
  }

  /* Rodapé inferior */
  .footer__bottom {
    border-top: 1px solid rgba(246, 239, 227, 0.1);
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: rgba(246, 239, 227, 0.4);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0;
  }

  .footer__privacy {
    color: rgba(246, 239, 227, 0.35);
    text-decoration: none;
    border-bottom: 1px solid rgba(246, 239, 227, 0.15);
    padding-bottom: 1px;
    transition: color var(--transition), border-color var(--transition);
  }

  .footer__privacy:hover {
    color: rgba(246, 239, 227, 0.65);
    border-color: rgba(246, 239, 227, 0.4);
  }

  .footer__disclaimer {
    font-size: var(--text-xs);
    color: rgba(246, 239, 227, 0.35);
    text-align: right;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 560px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .footer__contact {
      text-align: left;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__disclaimer {
      text-align: left;
    }
  }
</style>
