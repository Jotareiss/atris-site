---
const currentPath = Astro.url.pathname;
const isProfessionalsPage = currentPath.startsWith("/medicos");
const logoFullDarkDesktop = "/images/brand/atris_completo_claro.svg";
const logoFullLightDesktop = "/images/brand/atris_completo.svg";
const logoFullDarkMobile = "/images/brand/atris_limpo_claro.svg";
const logoFullLightMobile = isProfessionalsPage
  ? "/images/brand/Atris_limpo_medio.svg"
  : "/images/brand/atris_limpo.svg";

const links = [
  { label: "Manifesto",    href: "/manifesto" },
  { label: "Profissionais", href: "/medicos" },
  { label: "Átris.social", href: "/social" },
  { label: "Contato",      href: "/contato" },
];
---

<!-- ═══════════════════════════════════
     Navbar fixa — transparente sobre hero, sólida ao scroll
════════════════════════════════════ -->
<header class="nav" id="nav">
  <div class="nav__inner">

    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="Átris — página inicial">
      <img
        src={logoFullDarkDesktop}
        alt="Átris Instituto de Psiquiatria"
        class="nav__logo-full"
        height="116"
        data-logo-dark-desktop={logoFullDarkDesktop}
        data-logo-light-desktop={logoFullLightDesktop}
        data-logo-dark-mobile={logoFullDarkMobile}
        data-logo-light-mobile={logoFullLightMobile}
      />
      <img
        src="/images/brand/bird_swirl_claro.svg"
        alt=""
        class="nav__logo-bird"
        width="36"
        height="36"
        aria-hidden="true"
      />
    </a>

    <!-- Links -->
    <nav class="nav__links" aria-label="Navegação principal">
      {links.map(({ label, href }) => (
        <a
          href={href}
          class:list={["nav__link", { "nav__link--active": currentPath.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
    </nav>

    <!-- Burger (mobile) -->
    <button class="nav__burger" aria-label="Abrir menu" aria-expanded="false" id="nav-burger">
      <span class="nav__burger-text">Menu</span>
    </button>

  </div>
</header>

<!-- ═══════════════════════════════════
     Overlay mobile
════════════════════════════════════ -->
<div class="nav-overlay" id="nav-overlay" aria-hidden="true">
  <div class="nav-overlay__header">
    <a href="/" aria-label="Átris">
      <img src="/images/brand/atris_limpo_claro.svg" alt="Átris" height="76" />
    </a>
    <button class="nav-overlay__close" aria-label="Fechar menu" id="nav-overlay-close">Fechar</button>
  </div>
  <nav class="nav-overlay__links">
    {links.map(({ label, href }) => (
      <a href={href}>{label}</a>
    ))}
  </nav>
</div>

<style>
  /* ─── Barra ─── */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: transparent;
    transition: background 350ms ease, border-color 350ms ease;
    border-bottom: 1px solid transparent;
  }

  .nav.is-solid {
    background: var(--creme);
    border-bottom-color: rgba(66, 30, 41, 0.07);
  }

  .nav.is-compact:not(.is-solid) {
    background: var(--vinho);
    border-bottom-color: var(--vinho);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5.3vw;
    height: 124px;
    max-width: none;
    margin: 0 auto;
    transition: height 280ms ease;
  }

  .nav.is-compact .nav__inner {
    height: 72px;
  }

  /* ─── Logo ─── */
  .nav__logo {
    display: flex;
    align-items: center;
    position: relative;
    flex-shrink: 0;
    width: 180px;
    height: 112px;
    transition: width 280ms ease, height 280ms ease;
  }

  .nav.is-compact .nav__logo {
    width: 62px;
    height: 62px;
  }

  .nav__logo-full {
    display: block;
    height: 112px;
    width: auto;
    opacity: 1;
    transition: opacity 220ms ease;
  }

  .nav__logo-bird {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 62px;
    height: 62px;
    object-fit: contain;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  /* Ao scroll: full logo → bird-icon */
  .nav.is-compact .nav__logo-full,
  .nav.is-solid .nav__logo-full { opacity: 0; pointer-events: none; }

  .nav.is-compact .nav__logo-bird,
  .nav.is-solid .nav__logo-bird { opacity: 1; }

  /* ─── Links ─── */
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(42px, 4.8vw, 76px);
  }

  .nav__link {
    position: relative;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: none;
    color: rgba(246, 239, 227, 0.64);
    transition: color 200ms ease, opacity 200ms ease;
  }

  .nav__link:hover { color: rgba(246, 239, 227, 0.88); }

  .nav__link--active {
    color: rgba(246, 239, 227, 0.78);
  }

  .nav__link--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    display: block;
    height: 1px;
    background: var(--cobre);
    opacity: 0.95;
  }

  /* Dimming ao hover */
  .nav__links:has(a:hover) .nav__link:not(:hover) { opacity: 0.4; }

  /* Estado sólido */
  .nav.is-solid .nav__link { color: var(--color-text-secondary); }
  .nav.is-solid .nav__link:hover { color: var(--vinho); }
  .nav.is-solid .nav__link--active { color: var(--vinho); }
  .nav.is-solid .nav__link--active::after { background: var(--cobre); opacity: 0.95; }
  .nav.is-solid .nav__links:has(a:hover) .nav__link:not(:hover) { opacity: 0.45; }

  body:not(.page-edu) .nav:not(.nav--on-hero):not(.is-compact):not(.is-solid) .nav__link {
    color: var(--color-text-secondary);
  }

  body:not(.page-edu) .nav:not(.nav--on-hero):not(.is-compact):not(.is-solid) .nav__link:hover,
  body:not(.page-edu) .nav:not(.nav--on-hero):not(.is-compact):not(.is-solid) .nav__link--active {
    color: var(--vinho);
  }

  /* ─── Burger ─── */
  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 54px;
    height: 36px;
    background: none;
    border: none;
    padding: 4px 0;
    cursor: pointer;
  }

  .nav__burger-text {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(246, 239, 227, 0.82);
    text-transform: none;
    transition: background var(--transition);
  }

  .nav.is-solid .nav__burger-text { color: var(--vinho); }

  /* ─── Overlay mobile ─── */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--vinho);
    display: flex;
    flex-direction: column;
    padding: 28px 32px 48px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .nav-overlay.is-open { opacity: 1; pointer-events: auto; }

  .nav-overlay__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 56px;
  }

  .nav-overlay__close {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(245, 220, 183, 0.68);
    background: none;
    border: none;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--transition);
  }

  .nav-overlay__close:hover { opacity: 1; }

  .nav-overlay__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .nav-overlay__links a {
    font-size: clamp(34px, 11vw, 46px);
    font-style: italic;
    font-family: var(--font-body);
    color: #F5DCB7;
    line-height: 1.3;
    transition: opacity var(--transition);
  }

  .nav-overlay__links a:hover { opacity: 0.6; }

  /* ─── Responsivo ─── */
  @media (max-width: 768px) {
    .nav {
      border-bottom: 0;
    }

    .nav.is-compact,
    .nav.is-compact:not(.is-solid),
    .nav.is-compact.is-solid {
      background: rgba(66, 30, 41, 0.88);
      border-bottom: 0;
      box-shadow: 0 8px 24px rgba(27, 22, 22, 0.08);
      backdrop-filter: blur(8px);
    }

    .nav__inner {
      padding: 20px 24px 0;
      height: 96px;
    }

    .nav.is-compact .nav__inner {
      height: 64px;
      padding-top: 0;
    }

    .nav__logo {
      width: 108px;
      height: 70px;
    }

    .nav.is-compact .nav__logo {
      width: 58px;
      height: 60px;
    }

    .nav__logo-full {
      height: 70px;
      opacity: 0.72;
    }

    .nav.is-compact .nav__logo-full {
      height: 60px;
    }

    .nav.is-solid .nav__logo-full {
      opacity: 0.72;
      pointer-events: auto;
    }

    .nav__logo-bird,
    .nav.is-solid .nav__logo-bird {
      opacity: 0;
    }

    .nav.is-compact .nav__logo-full {
      opacity: 0;
      pointer-events: none;
    }

    .nav.is-compact .nav__logo-bird {
      width: 58px;
      height: 58px;
      opacity: 1;
    }

    .nav__links {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    .nav.is-compact .nav__burger-text,
    .nav.is-compact.is-solid .nav__burger-text {
      color: rgba(246, 239, 227, 0.86);
    }

    body:not(.page-edu) .nav:not(.nav--on-hero):not(.is-compact) .nav__burger-text {
      color: var(--vinho);
    }

    .nav-overlay {
      padding: 24px 28px 44px;
    }

    .nav-overlay__header {
      margin-bottom: 64px;
    }

    .nav-overlay__header img {
      height: 72px;
      opacity: 0.76;
    }

    .nav-overlay__links {
      gap: 14px;
    }
  }
</style>

<script>
  const nav    = document.getElementById("nav") as HTMLElement;
  const fullLogo = document.querySelector(".nav__logo-full") as HTMLImageElement;
  const birdLogo = document.querySelector(".nav__logo-bird") as HTMLImageElement;
  const hero   = document.querySelector(".hero") as HTMLElement;
  const burger = document.getElementById("nav-burger") as HTMLButtonElement;
  const overlay = document.getElementById("nav-overlay") as HTMLElement;
  const overlayClose = document.getElementById("nav-overlay-close") as HTMLButtonElement;

  // Scroll: transparente → sólido
  const updateCompactState = () => {
    if (!nav) return;

    const onHero = Boolean(hero && window.scrollY < hero.offsetHeight - 72);
    const isMobile = window.innerWidth <= 768;
    const compact = window.scrollY > (isMobile ? 96 : 48);
    const solid = nav.classList.contains("is-solid");
    const darkSurface = document.body.classList.contains("page-edu") || (onHero && !solid) || (compact && (!solid || isMobile));

    nav.classList.toggle("is-compact", compact);
    nav.classList.toggle("nav--on-hero", onHero);
    nav.classList.toggle("nav--dark-surface", darkSurface);

    if (fullLogo) {
      fullLogo.src = darkSurface
        ? (
            isMobile
              ? fullLogo.dataset.logoDarkMobile || "/images/brand/atris_limpo_claro.svg"
              : fullLogo.dataset.logoDarkDesktop || "/images/brand/atris_completo_claro.svg"
          )
        : (
            isMobile
              ? fullLogo.dataset.logoLightMobile || "/images/brand/atris_limpo.svg"
              : fullLogo.dataset.logoLightDesktop || "/images/brand/atris_completo.svg"
          );
    }

    if (birdLogo) {
      birdLogo.src = darkSurface
        ? "/images/brand/bird_swirl_claro.svg"
        : "/images/brand/bird_swirl_colorido.svg";
    }
  };

  updateCompactState();
  window.addEventListener("scroll", updateCompactState, { passive: true });

  let lastScrollY = -1;
  const watchScrollState = () => {
    if (window.scrollY !== lastScrollY) {
      lastScrollY = window.scrollY;
      updateCompactState();
    }
    requestAnimationFrame(watchScrollState);
  };
  requestAnimationFrame(watchScrollState);

  if (hero && nav) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        nav.classList.toggle("is-solid", !entry.isIntersecting);
        updateCompactState();
      },
      { threshold: 0.05 }
    );
    observer.observe(hero);
  }

  // Mobile overlay
  const openOverlay  = () => { overlay.classList.add("is-open"); overlay.setAttribute("aria-hidden","false"); burger.setAttribute("aria-expanded","true"); document.body.style.overflow="hidden"; };
  const closeOverlay = () => { overlay.classList.remove("is-open"); overlay.setAttribute("aria-hidden","true"); burger.setAttribute("aria-expanded","false"); document.body.style.overflow=""; };

  burger?.addEventListener("click", openOverlay);
  overlayClose?.addEventListener("click", closeOverlay);
  overlay?.querySelectorAll("a").forEach(l => l.addEventListener("click", closeOverlay));
  document.addEventListener("keydown", e => { if (e.key==="Escape") closeOverlay(); });
</script>
