---
import Layout from "../layouts/Layout.astro";

const professionals = [
  {
    name: "Dr. José Augusto Silva Reis",
    photo: "/assets/founder_jose.jpg",
    photoWebp: "/assets/founder_jose.webp",
    photoWidth: 2804,
    photoHeight: 1870,
    alt: "Retrato editorial do Dr. José Augusto Silva Reis",
    role: "Médico assistente no HCRP-USP, responsável pelo serviço de esquizofrenia e reabilitação psicossocial — acompanhamento longitudinal e recuperação no adoecimento mental crônico.",
    formation: "Formado pela FMRP-USP. Psiquiatra pelo HCRP-USP. Doutorando em saúde mental, com foco no uso de psicodélicos para o tratamento de transtornos mentais.",
    crm: "CRM/SP 199536 · RQE 128556",
    wa: "https://wa.me/5516996349613",
    cta: "Entrar em contato",
  },
  {
    name: "Dra. Lara Zancaner Ueta",
    photo: "/assets/founder_lara.jpg",
    photoWebp: "/assets/founder_lara.webp",
    photoWidth: 2804,
    photoHeight: 1870,
    alt: "Retrato editorial da Dra. Lara Zancaner Ueta",
    role: "Médica assistente no HCRP-USP, responsável pela interconsulta psiquiátrica — cuidado psiquiátrico associado ao adoecimento físico — e pelo serviço de esquizofrenia e reabilitação psicossocial.",
    formation: "Formada em medicina pela PUC-Campinas. Psiquiatra pelo HCRP-USP. Mestre em saúde mental pela FMRP-USP, com foco em neuroimagem na esquizofrenia.",
    crm: "CRM/SP 164028 · RQE 65684",
    wa: "https://wa.me/5516996349613",
    cta: "Entrar em contato",
  },
  {
    name: "Dr. Lean Pampana Basoli",
    photo: "/assets/founder_lean.jpg",
    photoWebp: "/assets/founder_lean.webp",
    photoWidth: 2771,
    photoHeight: 1892,
    alt: "Retrato editorial do Dr. Lean Pampana Basoli",
    role: "Médico assistente no ambulatório de sexualidade do HCRP-USP — diversidade de gênero, saúde sexual e cuidado em saúde mental LGBTQIA+.",
    formation: "Formado pela FMRP-USP. Psiquiatra pelo HCRP-USP. Mestrando em saúde mental, com foco em stress pós-traumático e violência sexual.",
    crm: "CRM/SP 199566 · RQE 127180",
    wa: "https://wa.me/5516996349613",
    cta: "Entrar em contato",
  },
];
---

<Layout
  title="Psiquiatras em Ribeirão Preto | Átris Psiquiatria"
  description="Conheça os psiquiatras da Átris: esquizofrenia, reabilitação psicossocial, diversidade de gênero e psicodélicos em psiquiatria, em Ribeirão Preto."
>
  <section class="hero professionals-hero">
    <div class="professionals-hero__overlay" aria-hidden="true"></div>
    <div class="professionals-hero__content">
      <p class="professionals-hero__kicker">Equipe clínica</p>
      <h1 class="professionals-hero__title">Os médicos</h1>
      <p class="professionals-hero__text">
        As mãos que fazem a Átris.
      </p>
    </div>
  </section>

  <div class="professionals-list">
    {professionals.map((professional, index) => (
      <div class="professional-entry">
        <section class:list={["professional-section", { "professional-section--reverse": index % 2 === 1 }]}>
          <figure class="professional-section__figure">
            <picture>
              <source srcset={professional.photoWebp} type="image/webp" />
              <img
                src={professional.photo}
                alt={professional.alt}
                width={professional.photoWidth}
                height={professional.photoHeight}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </figure>

          <div class="professional-section__content">
            <p class="professional-section__eyebrow">Psiquiatra</p>
            <h2>{professional.name}</h2>
            <p class="professional-section__role">{professional.role}</p>
            <span class="professional-section__rule" aria-hidden="true"></span>
            <p class="professional-section__formation">{professional.formation}</p>
            <div class="professional-section__meta">
              <p>{professional.crm}</p>
            </div>
            <a href={professional.wa} class="professional-section__link">
              {professional.cta}
            </a>
          </div>
        </section>

        {index < professionals.length - 1 && (
          <hr class="card-divider" aria-hidden="true" />
        )}
      </div>
    ))}
  </div>

  <section class="professionals-cta">
    <div class="professionals-cta__overlay" aria-hidden="true"></div>
    <div class="professionals-cta__content">
      <p>Quando você estiver pronto, podemos começar</p>
      <a href="/contato">Agende sua consulta</a>
    </div>
  </section>
</Layout>

<style is:global>
  .professionals-hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background:
      linear-gradient(rgba(66, 30, 41, 0.18), rgba(66, 30, 41, 0.18)),
      url("/assets/ambient_1.jpg") center 54% / cover;
    color: var(--creme);
    font-family: var(--font-body);
  }

  .professionals-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 16% 76%, rgba(14, 7, 10, 0.7) 0%, rgba(66, 30, 41, 0.42) 34%, transparent 68%),
      linear-gradient(to right, rgba(23, 10, 15, 0.78) 0%, rgba(66, 30, 41, 0.46) 38%, rgba(66, 30, 41, 0.12) 100%),
      linear-gradient(to top, rgba(18, 9, 12, 0.74) 0%, rgba(66, 30, 41, 0.16) 50%, transparent 82%);
  }

  .professionals-hero__content {
    position: relative;
    width: min(920px, 100%);
    padding: 0 5.3vw 11vh;
  }

  .professionals-hero__kicker {
    margin: 0 0 28px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.38em;
    color: rgba(216, 119, 68, 0.86);
    text-transform: uppercase;
  }

  .professionals-hero__title {
    margin: 0 0 30px;
    font-size: clamp(54px, 6.2vw, 108px);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: 0;
    color: var(--creme);
  }

  .professionals-hero__text {
    margin: 0;
    max-width: 620px;
    font-size: clamp(18px, 1.55vw, 25px);
    font-style: italic;
    line-height: 1.55;
    color: rgba(246, 239, 227, 0.72);
  }

  @media (max-width: 560px) {
    .professionals-hero {
      min-height: 100svh;
      background-position: center center;
    }

    .professionals-hero__content {
      padding: 0 24px 62px;
    }

    .professionals-hero__kicker {
      margin-bottom: 22px;
      font-size: 10px;
      letter-spacing: 0.3em;
    }

    .professionals-hero__title {
      margin-bottom: 24px;
      font-size: clamp(44px, 15vw, 62px);
    }

    .professionals-hero__text {
      font-size: 17px;
    }
  }

  .professionals-list .card-divider {
    width: min(720px, calc(100% - 48px));
    height: 0;
    margin: 0 auto 120px;
    border: 0;
    border-top: 1px solid rgba(216, 119, 68, 0.32);
  }

  @media (max-width: 900px) {
    .professionals-list .card-divider {
      margin-bottom: 88px;
    }
  }
</style>

<style>
  .professional-section__eyebrow {
    margin: 0 0 26px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--cobre);
    text-transform: uppercase;
  }

  .professionals-list {
    font-family: var(--font-body);
    padding-top: 100px;
  }

  .professional-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.78fr);
    gap: 7vw;
    align-items: center;
    padding: 34px 5.3vw 132px;
  }

  .professional-section--reverse {
    grid-template-columns: minmax(360px, 0.78fr) minmax(0, 1fr);
  }

  .professional-section--reverse .professional-section__figure {
    order: 2;
  }

  .professional-section--reverse .professional-section__content {
    order: 1;
  }

  .professional-section__figure {
    margin: 0;
    min-height: 640px;
    overflow: hidden;
    background: var(--areia);
    border-radius: 48px 48px 6px 6px;
  }

  .professional-section__figure img {
    width: 100%;
    height: 100%;
    min-height: 640px;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.92) contrast(1.02);
  }

  .professional-section__content {
    max-width: 500px;
  }

  .professional-section__content h2 {
    margin: 0 0 22px;
    font-size: clamp(42px, 4.8vw, 78px);
    font-weight: 300;
    line-height: 1.02;
    color: var(--vinho);
  }

  .professional-section__role {
    margin: 0;
    font-size: 20px;
    font-style: italic;
    line-height: 1.6;
    color: var(--vinho);
  }

  .professional-section__rule {
    display: block;
    width: 34px;
    height: 1px;
    margin: 32px 0 30px;
    background: var(--cobre);
  }

  .professional-section__formation {
    margin: 0;
    font-size: 17px;
    line-height: 1.72;
    color: rgba(27, 22, 22, 0.72);
  }

  .professional-section__meta {
    margin: 38px 0 0;
    padding-top: 24px;
    border-top: 1px solid rgba(66, 30, 41, 0.1);
  }

  .professional-section__meta p {
    margin: 0 0 8px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }

  .professional-section__link {
    display: inline-flex;
    margin-top: 34px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cobre);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 8px;
    transition: color var(--transition), opacity var(--transition);
  }

  .professional-section__link:hover {
    color: var(--vinho);
    opacity: 0.78;
  }

  .professionals-cta {
    position: relative;
    margin: 0;
    padding: 0;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: url("/assets/ambient_3.jpg") center / cover;
    color: var(--creme);
    font-family: var(--font-body);
  }

  .professionals-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(66, 30, 41, 0.82) 0%,
      rgba(66, 30, 41, 0.56) 30%,
      rgba(66, 30, 41, 0.16) 62%,
      transparent 100%
    );
  }

  .professionals-cta__content {
    position: relative;
    width: min(760px, 100%);
    padding: 0 5.3vw;
  }

  .professionals-cta p {
    max-width: 560px;
    margin: 0 0 42px;
    font-size: clamp(32px, 4.6vw, 64px);
    font-weight: 300;
    line-height: 1.1;
  }

  .professionals-cta a {
    display: inline-flex;
    padding: 18px 36px;
    border: 1px solid rgba(216, 119, 68, 0.82);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(246, 239, 227, 0.92);
    transition: border-color var(--transition), color var(--transition);
  }

  .professionals-cta a:hover {
    border-color: var(--dourado);
    color: var(--creme);
  }

  @media (max-width: 900px) {
    .professional-section,
    .professionals-cta {
      padding-left: 24px;
      padding-right: 24px;
    }

    .professional-section,
    .professional-section--reverse {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .professional-section--reverse .professional-section__figure,
    .professional-section--reverse .professional-section__content {
      order: initial;
    }

    .professional-section__figure,
    .professional-section__figure img {
      min-height: 520px;
    }

    .professionals-list {
      padding-top: 56px;
    }
  }

  @media (max-width: 560px) {
    .professional-section__formation {
      font-size: 16px;
    }

    .professional-section {
      padding-top: 16px;
      padding-bottom: 82px;
    }

    .professional-section__figure,
    .professional-section__figure img {
      min-height: 440px;
    }

    .professional-section__content h2 {
      font-size: 40px;
    }

    .professional-section__role {
      font-size: 18px;
    }

    .professionals-cta {
      min-height: 60vh;
    }
  }

  @media (min-width: 769px) {
    .professionals-hero__title {
      font-size: clamp(40px, 4.65vw, 81px);
    }

    .professionals-hero__text {
      font-size: clamp(16px, 1.15vw, 20px);
    }

    .professional-section__content h2 {
      font-size: clamp(32px, 3.6vw, 59px);
    }

    .professionals-cta p {
      font-size: clamp(24px, 3.45vw, 54px);
    }
  }
</style>
