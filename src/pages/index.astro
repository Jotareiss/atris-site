---
import Layout from "../layouts/Layout.astro";

const WA = "https://wa.me/5516996349613?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20consulta%20na%20%C3%81tris.";
---

<Layout
  title="Átris — Psiquiatria de excelência"
  description="Consultas psiquiátricas com tempo, vínculo e rigor clínico. Atendimento presencial em Ribeirão Preto e por telemedicina em todo o Brasil."
>

  <!-- ══════════════════════════════════════
       HERO
  ══════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="hero__content">
      <p class="hero__location">Ribeirão Preto · SP</p>
      <h1 class="hero__headline">
        <em>Psiquiatria feita à mão.</em>
      </h1>
      <p class="hero__sub">
        <span>Atendimento psiquiátrico para adultos.</span>
        <span>Consultas presenciais e online.</span>
      </p>
      <div class="hero__actions">
        <a href={WA} class="hero__cta" target="_blank" rel="noopener noreferrer">
          Agendar consulta
        </a>
        <a href="/manifesto" class="hero__secondary">
          Conhecer a Átris <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       MANIFESTO
  ══════════════════════════════════════ -->
  <section class="manifesto">
    <div class="manifesto__grid">

      <div class="manifesto__aside">
        <p class="manifesto__label">Manifesto</p>
      </div>

      <div class="manifesto__body">
        <blockquote class="manifesto__quote">
          "O que preciso saber sobre você, <em>enquanto pessoa</em>, para
          lhe oferecer o melhor cuidado possível?"
        </blockquote>
        <span class="manifesto__dash"></span>
        <div class="manifesto__actions">
          <a href="/manifesto" class="manifesto__link">
            <em>Leia o manifesto completo →</em>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════
       COMO TRABALHAMOS
  ══════════════════════════════════════ -->
  <section class="pitch">
    <div class="pitch__grid">
      <div class="pitch__left">
        <p class="kicker">Como trabalhamos</p>
        <h2 class="pitch__heading">
          Você escolhe o médico. O resto é direto.
        </h2>
      </div>
      <div class="pitch__right">
        <p class="pitch__body">
          Você decide com quem quer se tratar e marca pelo WhatsApp.
          Presencial em Ribeirão Preto ou por telemedicina.
        </p>
        <a href="/medicos" class="pratica__cta">Conheça os médicos</a>
      </div>
    </div>
  </section>


</Layout>

<style>

  /* ── Kicker reutilizável ── */
  .kicker {
    font-size: 14px;
    font-style: italic !important;
    text-transform: none;
    color: var(--cobre) !important;
    margin: 0;
  }

  /* ════════════════════════════════
     HERO
  ════════════════════════════════ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--vinho);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url('/assets/hero.jpg?v=20260526');
    background-size: cover;
    background-position: 50% 52%;
    transform: scaleX(-1);
    filter: brightness(0.86) contrast(1.02) saturate(0.88);
    transform-origin: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 13% 78%, rgba(12, 8, 10, 0.76) 0%, rgba(66, 30, 41, 0.48) 28%, rgba(66, 30, 41, 0.12) 56%, transparent 74%),
      linear-gradient(to right, rgba(23, 10, 15, 0.82) 0%, rgba(66, 30, 41, 0.54) 24%, rgba(66, 30, 41, 0.2) 54%, transparent 100%),
      linear-gradient(to top, rgba(16, 8, 11, 0.74) 0%, rgba(66, 30, 41, 0.22) 42%, transparent 76%),
      linear-gradient(to bottom, rgba(20, 10, 13, 0.44) 0%, transparent 30%);
  }

  .hero__content {
    position: relative;
    padding: 0 5.3vw 8.8vh;
    max-width: 1080px;
  }

  .hero__location {
    margin: 0 0 42px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(216, 119, 68, 0.82);
  }

  .hero__headline {
    font-size: clamp(42px, 3.6vw, 64px);
    font-style: normal;
    font-weight: 300;
    color: var(--creme);
    line-height: 1.08;
    letter-spacing: 0;
    margin: 0 0 36px;
  }

  .hero__headline span,
  .hero__headline em {
    display: block;
  }

  .hero__headline em {
    font-style: italic;
    font-weight: 300;
  }

  .hero__sub {
    font-size: clamp(16px, 1.12vw, 21px);
    font-style: normal;
    color: rgba(246, 239, 227, 0.58);
    line-height: 1.7;
    margin: 0 0 58px;
    max-width: 760px;
  }

  .hero__sub span {
    display: block;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 44px;
    flex-wrap: wrap;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 300px;
    padding: 22px 42px;
    border: 1px solid rgba(216, 119, 68, 0.82);
    border-radius: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    font-style: normal;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(246, 239, 227, 0.78);
    background: rgba(66, 30, 41, 0.08);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition), color var(--transition);
  }

  .hero__cta:hover {
    border-color: var(--dourado);
    background: rgba(216, 119, 68, 0.12);
    color: var(--creme);
  }

  .hero__secondary {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(246, 239, 227, 0.36);
    transition: color var(--transition);
  }

  .hero__secondary:hover {
    color: rgba(246, 239, 227, 0.72);
  }

  /* ════════════════════════════════
     PITCH
  ════════════════════════════════ */
  .pitch {
    padding: 72px 56px 80px;
    background: rgba(122, 61, 39, 0.06);
  }

  .pitch__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  .pitch__left .kicker {
    margin-bottom: 24px;
  }

  .pitch__heading {
    font-size: clamp(28px, 3vw, 38px);
    font-style: italic;
    font-weight: 400;
    color: var(--vinho);
    line-height: 1.24;
    margin: 0;
  }

  .pitch__right {
    padding-top: 48px;
  }

  .pitch__body {
    font-size: 16px;
    color: #666;
    line-height: 1.88;
    margin: 0;
  }

  /* ════════════════════════════════
     NA PRÁTICA (CTA)
  ════════════════════════════════ */
  .pratica__cta {
    display: inline-block;
    margin-top: 52px;
    font-size: 16px;
    font-style: italic;
    color: var(--vinho);
    text-decoration: underline;
    text-decoration-color: var(--cobre);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
    transition: opacity var(--transition), text-decoration-color var(--transition);
  }

  .pratica__cta:hover {
    opacity: 0.75;
    text-decoration-color: var(--dourado);
  }

  /* ════════════════════════════════
     MANIFESTO
  ════════════════════════════════ */
  .manifesto {
    padding: 104px 56px 56px;
  }

  .manifesto__grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 80px;
    align-items: start;
  }

  .manifesto__label {
    font-size: 14px;
    font-style: italic;
    color: var(--cobre);
    margin: 0;
    padding-top: 6px;
  }

  .manifesto__quote {
    font-size: 19px;
    font-style: italic;
    font-weight: 400;
    color: var(--vinho);
    line-height: 1.8;
    margin: 0;
  }

  .manifesto__quote em {
    font-style: italic;
    color: var(--mogno);
  }

  .manifesto__dash {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--cobre);
    margin: 32px 0 28px;
  }

  .manifesto__actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .manifesto__link {
    font-size: 15px;
    color: var(--cobre);
    transition: opacity var(--transition);
  }

  .manifesto__link:hover {
    opacity: 0.75;
  }

  /* ════════════════════════════════
     RESPONSIVO
  ════════════════════════════════ */
  @media (max-width: 768px) {
    .hero {
      min-height: 100svh;
    }

    .hero::before {
      background-position: 47% 50%;
      filter: brightness(0.82) contrast(1.04) saturate(0.88);
    }

    .hero__overlay {
      background:
        radial-gradient(ellipse at 18% 72%, rgba(16, 8, 11, 0.72) 0%, rgba(66, 30, 41, 0.44) 32%, rgba(66, 30, 41, 0.14) 60%, transparent 78%),
        linear-gradient(to right, rgba(23, 10, 15, 0.76) 0%, rgba(66, 30, 41, 0.48) 44%, rgba(66, 30, 41, 0.18) 100%),
        linear-gradient(to top, rgba(16, 8, 11, 0.72) 0%, rgba(66, 30, 41, 0.18) 46%, transparent 78%);
    }

    .hero__content {
      padding: 0 24px 52px;
      max-width: 100%;
    }

    .hero__location {
      margin-bottom: 26px;
      font-size: 10px;
      letter-spacing: 0.3em;
    }

    .hero__headline {
      font-size: clamp(34px, 10.8vw, 44px);
      line-height: 1.13;
      margin-bottom: 26px;
    }

    .hero__sub {
      max-width: 100%;
      font-size: 15px;
      line-height: 1.72;
      margin-bottom: 36px;
    }

    .hero__actions {
      gap: 18px;
    }

    .hero__cta {
      width: 100%;
      min-width: 0;
      padding: 18px 22px;
      font-size: 11px;
      letter-spacing: 0.28em;
    }

    .hero__secondary {
      width: 100%;
      font-size: 10px;
      letter-spacing: 0.28em;
    }

    .pitch,
    .manifesto {
      padding-left: 24px;
      padding-right: 24px;
    }

    .pitch__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .pitch__right {
      padding-top: 0;
    }

    .manifesto__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (min-width: 769px) {
    .hero__headline {
      font-size: clamp(32px, 2.7vw, 48px);
    }

    .hero__sub {
      font-size: clamp(16px, 1.15vw, 20px);
    }

    .pitch__heading {
      font-size: clamp(21px, 2.25vw, 29px);
    }
  }

</style>
