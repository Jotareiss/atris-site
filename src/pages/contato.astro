---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contato — Átris Instituto de Psiquiatria"
  description="Entre em contato pelo WhatsApp. Atendimento presencial em Ribeirão Preto e telemedicina para todo o Brasil."
>
  <div class="contato-page">
    <div class="contato-col">
      <div class="contact-heading">
        <span class="eyebrow">Contato</span>
        <h1 class="page-title">Fale com<br />a gente.</h1>
        <span class="divider" aria-hidden="true"></span>
      </div>

      <div class="contact-core">
        <p class="body">O agendamento é feito por WhatsApp.</p>

        <a
          href="https://wa.me/5516993732111?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20consulta%20na%20%C3%81tris."
          class="btn btn--primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar consulta <span aria-hidden="true">→</span>
        </a>

        <p class="support">
          A equipe pode orientar na escolha do médico e na organização do atendimento, de acordo com cada caso e disponibilidade.
        </p>
      </div>

      <figure class="contact-image" aria-hidden="true">
        <img src="/assets/ambient_4.jpg" alt="" />
      </figure>

      <div class="info">
        <p class="info__line">Ribeirão Preto, SP · presencial</p>
        <p class="info__line">Telemedicina para todo o Brasil</p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contato-page {
    background: var(--color-bg);
    font-family: var(--font-body);
  }

  .contato-col {
    width: min(1180px, calc(100% - 10.6vw));
    margin: 0 auto;
    padding: 142px 0 108px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 0.72fr);
    column-gap: 10vw;
    row-gap: 58px;
    align-items: center;
    text-align: left;
  }

  .contact-heading {
    grid-column: 1;
    grid-row: 1;
  }

  .eyebrow {
    display: block;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-orange);
    margin-bottom: 20px;
  }

  .page-title {
    font-size: clamp(60px, 6vw, 96px) !important;
    font-style: italic;
    font-weight: 300;
    color: var(--color-primary);
    line-height: 0.98;
    margin: 0;
    max-width: 560px;
  }

  .divider {
    display: block;
    width: 42px;
    height: 1px;
    background: var(--color-orange);
    margin: 34px 0 0;
  }

  .contact-core {
    grid-column: 2;
    grid-row: 1;
    max-width: 430px;
    padding: 38px 0 0;
    border-top: 1px solid rgba(66, 30, 41, 0.08);
  }

  .body {
    font-size: 18px;
    font-style: italic;
    line-height: 1.85;
    color: #666;
    margin: 0 0 30px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 48px;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    transition: color var(--transition), border-color var(--transition), opacity var(--transition), background var(--transition);
  }

  .btn--primary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-orange);
  }

  .btn--primary:hover {
    color: var(--color-orange);
    opacity: 0.86;
  }

  .support {
    font-size: 14px;
    font-style: italic;
    color: var(--color-text-secondary);
    line-height: 1.75;
    max-width: 360px;
    margin: 42px 0 0;
  }

  .contact-image {
    grid-column: 1 / -1;
    width: min(1320px, 100%);
    height: 340px;
    margin: 0 auto;
    overflow: hidden;
    background: var(--vinho);
  }

  .contact-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 24%;
    opacity: 0.78;
    filter: saturate(0.82) contrast(1.02);
  }

  .info {
    grid-column: 1 / -1;
    border-top: 1px solid rgba(231, 184, 100, 0.27);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    gap: 36px;
  }

  .info__line {
    font-size: 15px;
    font-style: italic;
    color: rgba(66, 30, 41, 0.62);
    margin: 0;
    line-height: 1.62;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .contato-col {
      width: auto;
      max-width: 640px;
      padding: 112px 24px 118px;
      display: block;
      text-align: center;
    }

    .page-title {
      font-size: 30px !important;
      font-weight: 400;
      line-height: 1.2;
    }

    .divider {
      margin: 22px auto 28px;
    }

    .contact-core {
      max-width: 460px;
      margin: 0 auto;
    }

    .support {
      margin-left: auto;
      margin-right: auto;
    }

    .contact-image {
      width: 100%;
      height: 150px;
      margin-top: 42px;
    }

    .info {
      margin-top: 42px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-top: 24px;
    }
  }

  @media (max-width: 400px) {
    .btn {
      width: 100%;
      padding-left: 20px;
      padding-right: 20px;
    }
  }
</style>
