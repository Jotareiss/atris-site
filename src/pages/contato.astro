---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Agendar Consulta | Átris Psiquiatria — Ribeirão Preto"
  description="Agende sua consulta psiquiátrica pelo WhatsApp com a Átris, em Ribeirão Preto ou por telemedicina em todo o Brasil."
>
  <section class="hero contato-hero">
    <div class="contato-hero__overlay" aria-hidden="true"></div>
    <div class="contato-hero__content">
      <p class="contato-hero__kicker">Contato</p>
      <h1 class="contato-hero__title">Fale com a Átris.</h1>
      <p class="contato-hero__text">O agendamento é feito por WhatsApp.</p>

      <a
        href="https://wa.me/5516996349613?text=Ol%C3%A1%2C%20gostaria%20de%20agendar%20uma%20consulta%20na%20%C3%81tris."
        class="contato-hero__button"
        target="_blank"
        rel="noopener noreferrer"
      >
        Agendar consulta <span aria-hidden="true">→</span>
      </a>

      <p class="contato-hero__support">
        A secretária responde de segunda a sexta, das 08h00 às 18h00.
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  .contato-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: url("/assets/ambient_7.jpg") center 32% / cover;
    color: var(--creme);
    font-family: var(--font-body);
  }

  .contato-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(23, 10, 15, 0.82) 0%, rgba(66, 30, 41, 0.5) 42%, rgba(66, 30, 41, 0.14) 72%, transparent 100%),
      linear-gradient(to top, rgba(18, 9, 12, 0.5) 0%, transparent 40%);
  }

  .contato-hero__content {
    position: relative;
    width: min(620px, 100%);
    padding: 140px 5.3vw 96px;
  }

  .contato-hero__kicker {
    margin: 0 0 26px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.34em;
    color: rgba(216, 119, 68, 0.9);
    text-transform: uppercase;
  }

  .contato-hero__title {
    margin: 0 0 32px;
    font-size: clamp(38px, 4.4vw, 64px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.12;
    color: var(--creme);
  }

  .contato-hero__text {
    margin: 0 0 40px;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.6;
    color: rgba(246, 239, 227, 0.86);
  }

  .contato-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 18px 40px;
    border: 1px solid rgba(216, 119, 68, 0.82);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(246, 239, 227, 0.94);
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }

  .contato-hero__button:hover {
    border-color: var(--dourado);
    background: rgba(216, 119, 68, 0.12);
  }

  .contato-hero__support {
    margin: 40px 0 0;
    max-width: 420px;
    font-size: 14px;
    font-style: italic;
    line-height: 1.75;
    color: rgba(246, 239, 227, 0.64);
  }

  @media (max-width: 768px) {
    .contato-hero {
      min-height: 100svh;
      background-position: 62% center;
    }

    .contato-hero__overlay {
      background:
        linear-gradient(to top, rgba(18, 9, 12, 0.86) 0%, rgba(66, 30, 41, 0.5) 46%, rgba(66, 30, 41, 0.2) 72%, transparent 100%);
    }

    .contato-hero__content {
      width: 100%;
      padding: 0 24px 64px;
    }

    .contato-hero__title {
      font-size: clamp(30px, 8vw, 40px);
    }

    .contato-hero__support {
      max-width: none;
    }
  }
</style>
