---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  preloadImage?: string;
  preloadFonts?: string[];
  pageSchema?: Record<string, any>[];
}

const {
  title = "Átris — Clínica Psiquiátrica",
  description = "Cuidado psiquiátrico com presença e escuta.",
  bodyClass,
  preloadImage,
  preloadFonts = [],
  pageSchema = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImageURL = new URL("/og-image.jpg", Astro.site ?? Astro.url.origin);

const SITE = "https://atrispsiquiatria.com.br";

// Identidade da instituição -- presente em todas as paginas via @id,
// referenciada (nao duplicada) pelos schemas especificos de cada pagina.
const organizationSchema = {
  "@type": "MedicalClinic",
  "@id": `${SITE}/#organization`,
  "name": "Átris Psiquiatria",
  "description": "Clínica de psiquiatria em Ribeirão Preto, SP, com atendimento presencial e por telemedicina.",
  "url": SITE,
  "telephone": "+5516996349613",
  "image": `${SITE}/og-image.jpg`,
  "logo": `${SITE}/bird-icon.png`,
  "sameAs": ["https://www.instagram.com/atrispsiquiatria/"],
  "medicalSpecialty": "Psychiatric",
  "hasMap": "https://www.google.com/maps/place/?q=place_id:ChIJwT0wvJ-5uZQRfaLS5RqZM3c",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Cavalheiro Torquato Rizzi, 1805, sala 24",
    "addressLocality": "Ribeirão Preto",
    "addressRegion": "SP",
    "postalCode": "14021-676",
    "addressCountry": "BR",
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00",
  },
  "employee": [
    { "@id": `${SITE}/medicos#dr-jose-augusto-silva-reis` },
    { "@id": `${SITE}/medicos#dra-lara-zancaner-ueta` },
    { "@id": `${SITE}/medicos#dr-lean-pampana-basoli` },
  ],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  "url": SITE,
  "name": "Átris Psiquiatria",
  "publisher": { "@id": `${SITE}/#organization` },
};

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [organizationSchema, websiteSchema, ...pageSchema],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:locale"      content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/bird-icon.png" />

    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    {preloadFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}

    <meta name="generator" content={Astro.generator} />

    <!-- Structured data (Google / Google Maps / IA) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </head>

  <body class:list={[bodyClass]}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
