---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "Átris — Clínica Psiquiátrica",
  description = "Cuidado psiquiátrico de excelência, com presença e escuta. Consultas presenciais e por telemedicina em todo o Brasil.",
  bodyClass,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content="/og-image.jpg" />
    <meta property="og:locale"      content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content="/og-image.jpg" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/bird-icon.png" />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body class:list={[bodyClass, "site-locked"]}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <section class="access-gate" id="access-gate" aria-labelledby="access-gate-title">
      <div class="access-gate__panel">
        <img
          class="access-gate__logo"
          src="/images/brand/atris_completo.svg"
          alt="Átris Instituto de Psiquiatria"
        />
        <p class="access-gate__kicker">Site em construção</p>
        <h1 id="access-gate-title">Estamos preparando este espaço.</h1>
        <form class="access-gate__form" id="access-gate-form">
          <label class="access-gate__label" for="access-gate-password">
            Acesso restrito
          </label>
          <div class="access-gate__row">
            <input
              id="access-gate-password"
              class="access-gate__input"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Senha"
            />
            <button class="access-gate__button" type="submit">Entrar</button>
          </div>
          <p class="access-gate__error" id="access-gate-error" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <script is:inline>
      (() => {
        const password = "draarlete";
        const storageKey = "atris_site_access";
        const body = document.body;
        const gate = document.getElementById("access-gate");
        const form = document.getElementById("access-gate-form");
        const input = document.getElementById("access-gate-password");
        const error = document.getElementById("access-gate-error");

        const unlock = () => {
          body.classList.remove("site-locked");
          gate?.setAttribute("hidden", "");
        };

        if (window.localStorage.getItem(storageKey) === "granted") {
          unlock();
          return;
        }

        input?.focus();

        form?.addEventListener("submit", (event) => {
          event.preventDefault();
          const value = input instanceof HTMLInputElement ? input.value.trim() : "";

          if (value === password) {
            window.localStorage.setItem(storageKey, "granted");
            unlock();
            return;
          }

          if (error) {
            error.textContent = "Senha incorreta.";
          }

          if (input instanceof HTMLInputElement) {
            input.value = "";
            input.focus();
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  body.site-locked {
    overflow: hidden;
  }

  body.site-locked > nav,
  body.site-locked > main,
  body.site-locked > footer,
  body.site-locked > astro-dev-toolbar {
    display: none !important;
  }

  .access-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 32px;
    background:
      radial-gradient(ellipse at 18% 20%, rgba(231, 184, 100, 0.16), transparent 38%),
      linear-gradient(135deg, var(--creme) 0%, var(--areia) 100%);
    color: var(--vinho);
    font-family: var(--font-body);
  }

  .access-gate[hidden] {
    display: none;
  }

  .access-gate__panel {
    width: min(520px, 100%);
  }

  .access-gate__logo {
    width: min(220px, 62vw);
    height: auto;
    margin: 0 0 72px;
  }

  .access-gate__kicker {
    margin: 0 0 24px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--cobre);
  }

  .access-gate h1 {
    max-width: 480px;
    margin: 0;
    font-size: clamp(38px, 5.2vw, 68px);
    font-weight: 300;
    font-style: italic;
    line-height: 1.05;
    color: var(--vinho);
  }

  .access-gate__form {
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid rgba(216, 119, 68, 0.26);
  }

  .access-gate__label {
    display: block;
    margin-bottom: 16px;
    font-size: 14px;
    font-style: italic;
    color: var(--muted);
  }

  .access-gate__row {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }

  .access-gate__input,
  .access-gate__button {
    min-height: 52px;
    border-radius: 0;
    font-family: var(--font-body);
  }

  .access-gate__input {
    flex: 1;
    min-width: 0;
    padding: 0 16px;
    border: 1px solid rgba(66, 30, 41, 0.22);
    background: rgba(246, 239, 227, 0.58);
    color: var(--texto);
    font-size: 16px;
    outline: none;
  }

  .access-gate__input:focus {
    border-color: rgba(216, 119, 68, 0.82);
  }

  .access-gate__button {
    padding: 0 24px;
    border: 1px solid var(--cobre);
    background: transparent;
    color: var(--vinho);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background var(--transition), color var(--transition);
  }

  .access-gate__button:hover {
    background: var(--cobre);
    color: var(--creme);
  }

  .access-gate__error {
    min-height: 20px;
    margin: 14px 0 0;
    font-size: 13px;
    font-style: italic;
    color: var(--cobre);
  }

  @media (max-width: 560px) {
    .access-gate {
      align-items: start;
      padding: 86px 24px 32px;
    }

    .access-gate__logo {
      width: 150px;
      margin-bottom: 64px;
    }

    .access-gate__row {
      flex-direction: column;
    }

    .access-gate__button {
      width: 100%;
    }
  }
</style>
